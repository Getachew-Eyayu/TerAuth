# ==============================================================================
# TerAuth Local Docker Compose Environment Template
# ==============================================================================
# Copy this file to .env.docker or pass variables to docker compose.
# By default, docker-compose.yml uses safe built-in defaults for isolated local runs.

# Local PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
POSTGRES_DB=terauth

# Host port mapping for local PostgreSQL (5433 avoids conflict with host port 5432)
POSTGRES_PORT=5433

# JWT Authentication Secrets (256-bit cryptographically secure strings)
JWT_ACCESS_SECRET=0631ece8458769567df62a66e3ffdc91481800c150a904ae6bd8efff5ed3f44d
JWT_REFRESH_SECRET=0938c8726cbb4fa34aa8f831c2ac4fe60c2c5837a3dad239d716f97afab8bf39
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Host URL & Permitted Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000,http://127.0.0.1:5173
