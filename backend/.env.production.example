# ==============================================================================
# TerAuth Production Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Production Database (PostgreSQL mandatory for production)
DATABASE_URL="postgresql://postgres:STRONG_PASSWORD_HERE@db.terauth.gov.et:5432/terauth_prod?schema=public&sslmode=prefer"

# JWT Authentication Secrets (Must be at least 256-bit cryptographically secure strings)
# Note: At startup, TerAuth will fail fast if these keys match defaults or are not set.
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_64_CHARACTER_RANDOM_HEX_STRING_FOR_ACCESS_TOKEN"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_64_CHARACTER_RANDOM_HEX_STRING_FOR_REFRESH_TOKEN"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Host URL (Used to construct cryptographic verification QR code URLs)
FRONTEND_URL="https://verify.terauth.gov.et"

# CORS Allowed Origins (Comma-separated list of permitted origins, no wildcards)
ALLOWED_ORIGINS="https://verify.terauth.gov.et,https://admin.terauth.gov.et"
