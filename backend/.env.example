# Database connection URL
# For PostgreSQL (Default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/terauth?schema=public"

# For SQLite zero-config fallback (run `npm run db:use-sqlite`):
# DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret Keys (Replace with strong random keys in production)
JWT_ACCESS_SECRET=terauth_jwt_access_secret_production_ready_key_2026
JWT_REFRESH_SECRET=terauth_jwt_refresh_secret_production_ready_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (For QR code links and CORS validation)
FRONTEND_URL=http://localhost:5173
