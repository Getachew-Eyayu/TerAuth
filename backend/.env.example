# Database connection URL
# For PostgreSQL (Default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/terauth?schema=public"

# For SQLite zero-config fallback (run `npm run db:use-sqlite`):
# DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret Keys (MANDATORY IN PRODUCTION: Must be cryptographically random and unique)
# Note: Production mode (NODE_ENV=production) will reject default/fallback secrets at boot time
JWT_ACCESS_SECRET=replace_with_a_secure_random_256bit_access_secret_key_in_production
JWT_REFRESH_SECRET=replace_with_a_secure_random_256bit_refresh_secret_key_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL and Allowed Origins (For QR code links and CORS validation)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
